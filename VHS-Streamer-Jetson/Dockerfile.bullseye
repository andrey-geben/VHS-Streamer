# =====================================================================
#  VHS-Streamer — образ для Jetson с JetPack 4.x (Ubuntu 18.04, ядро 4.9)
# ---------------------------------------------------------------------
#  Отличие от основного Dockerfile: базовый образ Debian 11
#  (python 3.10, glibc 2.31). Он лучше заводится на старом ядре 4.9,
#  чем ubuntu:22.04.
#
#  Сборка и запуск:
#      docker build -f VHS-Streamer-Jetson/Dockerfile.bullseye \
#                   -t vhs-streamer:jetson ..
#      cd VHS-Streamer-Jetson && docker compose up -d --no-build
# =====================================================================
FROM python:3.10-slim-bullseye

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TZ=Asia/Yekaterinburg

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        ca-certificates \
        curl \
        tar \
        xz-utils \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY VHS-Streamer-Jetson/requirements-docker.txt /app/requirements-docker.txt
RUN pip install --no-cache-dir -r /app/requirements-docker.txt

COPY . /app

RUN mkdir -p /app/bin \
    && ln -sf /usr/bin/ffmpeg /app/bin/ffmpeg \
    && ln -sf /usr/bin/ffprobe /app/bin/ffprobe

RUN chmod +x /app/VHS-Streamer-Jetson/entrypoint.sh || true

EXPOSE 8000 8081 8554 8889 8080
EXPOSE 8189/udp

ENTRYPOINT ["/bin/bash", "/app/VHS-Streamer-Jetson/entrypoint.sh"]
